# Market data source: "open" (default, no key) or "sectors" (legacy, needs a key)
MARKET_DATA_PROVIDER=open

# Optional: legacy Sectors API (only when MARKET_DATA_PROVIDER=sectors)
SECTORS_API_KEY=

# OpenRouter untuk synthesis dan embedding semantic cache
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Opsional
OPENROUTER_MODEL=qwen/qwen3.5-397b-a17b
QDRANT_URL=http://localhost:6333
REDIS_URL=redis://localhost:6379
